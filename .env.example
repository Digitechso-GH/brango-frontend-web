################################################################################
# .env.example (PLANTILLA PARA EL FRONTEND DE PRODUCCIÓN)
#
# ⚠️ IMPORTANTE: Este archivo es solo una PLANTILLA / GUÍA.
# Vercel / GitHub Actions NO leen este archivo.
# NO DEBES poner contraseñas ni llaves reales aquí.
#
# ¿Para qué sirve?
# Cuando vayas a desplegar la web en producción, usa esta plantilla para saber 
# qué variables exactas tienes que pegar a mano en tu panel de Vercel o en los 
# Secrets de GitHub Actions.
#
# ¿Por qué tiene URLs reales?
# Las variables que ves aquí (como la URL de tu API en producción) son ejemplos 
# seguros y públicos. Las llaves secretas o privadas sí deben estar vacías.
################################################################################

# --- CONECTIVIDAD API ---
NEXT_PUBLIC_API_URL=https://api.brango.syncrodg.com
NEXT_PUBLIC_WS_URL=https://api.brango.syncrodg.com
NEXT_PUBLIC_DEV_MOCK_TOKEN=

# --- GOOGLE MAPS (CLOUD STYLING WEB) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu_google_api_key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=tu_google_map_id
